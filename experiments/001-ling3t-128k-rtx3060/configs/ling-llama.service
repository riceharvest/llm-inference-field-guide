[Unit]
Description=Ling-3.0-tiny llama.cpp server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/llama-server \
  -m ${MODEL_PATH} \
  --host 0.0.0.0 \
  --port ${PORT:-12445} \
  -c 131072 \
  -n 16384 \
  -b 2048 \
  -ub 512 \
  -ngl 999 \
  --device CUDA0 \
  -fa auto \
  -ctk bf16 \
  -ctv bf16 \
  --load-mode mmap+mlock \
  --parallel 2 \
  --poll 50 \
  --poll-batch 1 \
  --prio 2 \
  --prio-batch 2 \
  -t 14 \
  -tb 16 \
  --temp 1.0 \
  --top-p 0.95 \
  --top-k 20
Restart=always
RestartSec=5
MemoryMax=20G
Delegate=no

[Install]
WantedBy=default.target
